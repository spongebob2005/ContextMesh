# Copy to .env and fill in.

# HydraDB (graph-node) HTTP query API
HYDRA_HTTP_URI=http://127.0.0.1:8443
HYDRA_TOKEN=hydra-hackathon-local-dev-token-32ch
HYDRA_NAMESPACE=agent
HYDRA_GRAPH_ID=default
HYDRA_CELL_ID=cell-0

# Agent root node id (integer vertex id)
HYDRA_AGENT_ID=agent-0

# ContextMesh API (optional)
# CORS origins for browser clients: "*" or comma-separated origins
CONTEXTSMESH_CORS_ORIGINS=*
# When set, /v1/plan, /v1/session, /v1/stats require X-API-Key or Bearer.
# Leave empty for local demos and terminate auth at your gateway instead.
CONTEXTSMESH_API_KEY=

# LLM: provider/model via langchain init_chat_model
# e.g. openai/gpt-4o-mini, anthropic/claude-3-5-haiku-latest, ollama/llama3.1
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
